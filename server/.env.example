# Local defaults. Render supplies PORT automatically; do not override it there.
PORT=3101
# HOST is a development override. Production always binds 0.0.0.0.
HOST=0.0.0.0
# REQUIRED when NODE_ENV=production: exact public frontend origin (no path).
# FRONTEND_URL=https://your-property-tycoon-client.onrender.com
# Optional extra origins; also retains compatibility with older local setups.
# CLIENT_ORIGINS=http://192.168.1.10:5173
# NODE_ENV=production
